def BB180_css : CSS_pair 180 90 90 :=
  CSS_pair.of_matrices BB180_X_mat BB180_Z_mat BB180_XZ_orth
theorem BB180_dist_16 : 16 ≤ BB180_css.toBSM.distance (by norm_num) := by
  apply bitvec_sat_translation_correct BB180_css
      BB180_Z_ker_mat BB180_Z_ker_is_ker
      BB180_X_ker_mat BB180_X_ker_is_ker (by norm_num) _ _
  · rw [BB180_css, CSS_pair.of_matrices, ←BB180_X_correct, BB180_Z_ker_mat_correct]
    exact BB180_dist_z
  rw [BB180_css, CSS_pair.of_matrices, ←BB180_Z_correct, BB180_X_ker_mat_correct]
  exact BB180_dist_x
