import QuantumLib.QECC.StabilizerFacts

/-!
# Stabilizer groups presented by generators

Every stabilizer group is generated by a finite family of pairwise-commuting Pauli operators that
square to the identity. This file gives the subgroup such a family generates an explicit *normal
form*: it is exactly the image of the `GF(2)`-linear map

`genSpan g : (Fin m → ZMod 2) → PauliOp n`,  `a ↦ ∏ i, (g i) ^ aᵢ`.

Three otherwise intractable questions thereby become finite and decidable:

* membership in the stabilizer (`IsGenFamily.mem_closure_iff`),
* membership in `carrier ⊔ phaseSubgroup` — the operators acting trivially on the code space
  (`mem_sup_phaseSubgroup_iff`),
* and hence `IsLogical` (`StabGroup.isLogical_iff_of_gens`) and `distance`
  (`StabGroup.distance_eq`).

The product is taken over `List.finRange m` rather than as a `Finset.prod`, both because `PauliOp n`
is not commutative (so `∏` is unavailable) and because `List.prod` evaluates — the concrete codes in
`QECC.Codes` discharge their `distance` obligations by `decide`.
-/

open scoped BigOperators
namespace QuantumLib
namespace PauliOp

variable {n m : ℕ}

/-! ### Products of commuting elements -/

section Generic
variable {G : Type*} [Monoid G] {ι : Type*}

/-- Two products over the same list may be interleaved when their factors commute. -/
theorem list_prod_mul_prod (l : List ι) (f₁ f₂ : ι → G)
    (hc : ∀ i ∈ l, ∀ j ∈ l, _root_.Commute (f₁ i) (f₂ j)) :
    (l.map f₁).prod * (l.map f₂).prod = (l.map fun i => f₁ i * f₂ i).prod := by
  induction l with
  | nil => simp
  | cons a l ih =>
      have hcomm : _root_.Commute (l.map f₁).prod (f₂ a) :=
        (_root_.Commute.list_prod_right _ _ (by
          intro x hx
          obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hx
          exact (hc i (by simp [hi]) a (by simp)).symm)).symm
      have ih' := ih fun i hi j hj => hc i (by simp [hi]) j (by simp [hj])
      simp only [List.map_cons, List.prod_cons]
      calc f₁ a * (l.map f₁).prod * (f₂ a * (l.map f₂).prod)
          = f₁ a * ((l.map f₁).prod * f₂ a * (l.map f₂).prod) := by simp only [mul_assoc]
        _ = f₁ a * (f₂ a * ((l.map f₁).prod * (l.map f₂).prod)) := by
              rw [hcomm.eq]; simp only [mul_assoc]
        _ = f₁ a * f₂ a * (l.map fun i => f₁ i * f₂ i).prod := by rw [ih']; simp only [mul_assoc]

/-- A product all of whose factors but one are trivial. -/
theorem list_prod_single [DecidableEq ι] {l : List ι} {i : ι} (hi : i ∈ l) (hnd : l.Nodup)
    (f : ι → G) (h1 : ∀ j ∈ l, j ≠ i → f j = 1) : (l.map f).prod = f i := by
  induction l with
  | nil => simp at hi
  | cons b l ih =>
      rw [List.map_cons, List.prod_cons]
      rw [List.nodup_cons] at hnd
      rcases List.mem_cons.mp hi with rfl | hi'
      · rw [List.prod_eq_one (fun x hx => by
          obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hx
          exact h1 j (by simp [hj]) fun hji => hnd.1 (hji ▸ hj)), mul_one]
      · rw [h1 b (by simp) (by rintro rfl; exact hnd.1 hi'), one_mul]
        exact ih hi' hnd.2 fun j hj => h1 j (by simp [hj])

/-- For an involution, `x ^ a` depends only on `a mod 2`, and is additive in it. -/
theorem pow_val_add {x : G} (hx : x * x = 1) (s t : ZMod 2) :
    x ^ (s + t).val = x ^ s.val * x ^ t.val := by
  have h2 : ∀ u : ZMod 2, u = 0 ∨ u = 1 := by decide
  rcases h2 s with rfl | rfl <;> rcases h2 t with rfl | rfl <;>
    simp [show ((0 : ZMod 2)).val = 0 from rfl, show ((1 : ZMod 2)).val = 1 from rfl,
      show ((1 : ZMod 2) + 1).val = 0 from rfl, hx]

end Generic

/-! ### The `x`- and `z`-components of a product -/

variable {ι : Type*}

theorem list_prod_x (l : List ι) (f : ι → PauliOp n) :
    ((l.map f).prod).x = (l.map fun i => (f i).x).sum := by
  induction l with
  | nil => simp
  | cons a l ih => simp [mul_x, ih]

theorem list_prod_z (l : List ι) (f : ι → PauliOp n) :
    ((l.map f).prod).z = (l.map fun i => (f i).z).sum := by
  induction l with
  | nil => simp
  | cons a l ih => simp [mul_z, ih]

@[simp] theorem pow_x (P : PauliOp n) (k : ℕ) : (P ^ k).x = k • P.x := by
  induction k with
  | zero => simp
  | succ k ih => rw [pow_succ, mul_x, ih, succ_nsmul]

@[simp] theorem pow_z (P : PauliOp n) (k : ℕ) : (P ^ k).z = k • P.z := by
  induction k with
  | zero => simp
  | succ k ih => rw [pow_succ, mul_z, ih, succ_nsmul]

/-- The `ZMod 2` scalar action agrees with the `ℕ`-action through `ZMod.val`. -/
theorem val_nsmul (a : ZMod 2) (v : Fin n → ZMod 2) : (a.val) • v = a • v := by
  have h2 : ∀ u : ZMod 2, u = 0 ∨ u = 1 := by decide
  rcases h2 a with rfl | rfl <;>
    simp [show ((0 : ZMod 2)).val = 0 from rfl, show ((1 : ZMod 2)).val = 1 from rfl]

/-! ### The span of a generating family -/

/-- A family of pairwise-commuting Pauli involutions: the generating data of a stabilizer group. -/
structure IsGenFamily (g : Fin m → PauliOp n) : Prop where
  /-- The generators pairwise commute. -/
  comm : ∀ i j, _root_.Commute (g i) (g j)
  /-- Each generator squares to the identity. -/
  sq : ∀ i, g i * g i = 1

/-- The product of the generators selected by a `GF(2)` exponent vector. -/
def genSpan (g : Fin m → PauliOp n) (a : Fin m → ZMod 2) : PauliOp n :=
  ((List.finRange m).map fun i => g i ^ (a i).val).prod

variable {g : Fin m → PauliOp n}

@[simp] theorem genSpan_zero : genSpan g 0 = 1 := by
  apply List.prod_eq_one
  intro x hx
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp hx
  simp [show ((0 : ZMod 2)).val = 0 from rfl]

@[simp] theorem genSpan_x (a : Fin m → ZMod 2) : (genSpan g a).x = ∑ i, a i • (g i).x := by
  rw [genSpan, list_prod_x, Fin.sum_univ_def]
  exact congrArg List.sum (List.map_congr_left fun i _ => by rw [pow_x, val_nsmul])

@[simp] theorem genSpan_z (a : Fin m → ZMod 2) : (genSpan g a).z = ∑ i, a i • (g i).z := by
  rw [genSpan, list_prod_z, Fin.sum_univ_def]
  exact congrArg List.sum (List.map_congr_left fun i _ => by rw [pow_z, val_nsmul])

theorem genSpan_mem_closure (a : Fin m → ZMod 2) :
    genSpan g a ∈ Subgroup.closure (Set.range g) := by
  rw [genSpan]
  refine Subgroup.list_prod_mem _ fun x hx => ?_
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp hx
  exact Subgroup.pow_mem _ (Subgroup.subset_closure (Set.mem_range_self i)) _

/-! ### Products of purely `X`-type or purely `Z`-type generators

A product of `X`-type Paulis (or of `Z`-type Paulis) picks up no phase, because every `betaPair`
occurring along the way vanishes. This is what makes CSS stabilizer elements computable. -/

/-- The product of a list of phaseless Paulis with no `Z`-component. -/
theorem list_prod_of_z_zero (l : List ι) (f : ι → PauliOp n)
    (hph : ∀ i ∈ l, (f i).phase = 0) (h0 : ∀ i ∈ l, (f i).z = 0) :
    (l.map f).prod = ⟨0, (l.map fun i => (f i).x).sum, 0⟩ := by
  induction l with
  | nil => refine PauliOp.ext ?_ ?_ ?_ <;> simp
  | cons a l ih =>
      rw [List.map_cons, List.prod_cons,
        ih (fun i hi => hph i (by simp [hi])) (fun i hi => h0 i (by simp [hi]))]
      refine PauliOp.ext ?_ ?_ ?_
      · simp [betaPair, h0 a (by simp), hph a (by simp)]
      · simp
      · simp [h0 a (by simp)]

/-- The product of a list of phaseless Paulis with no `X`-component. -/
theorem list_prod_of_x_zero (l : List ι) (f : ι → PauliOp n)
    (hph : ∀ i ∈ l, (f i).phase = 0) (h0 : ∀ i ∈ l, (f i).x = 0) :
    (l.map f).prod = ⟨0, 0, (l.map fun i => (f i).z).sum⟩ := by
  induction l with
  | nil => refine PauliOp.ext ?_ ?_ ?_ <;> simp
  | cons a l ih =>
      rw [List.map_cons, List.prod_cons,
        ih (fun i hi => hph i (by simp [hi])) (fun i hi => h0 i (by simp [hi]))]
      refine PauliOp.ext ?_ ?_ ?_
      · simp [betaPair, hph a (by simp)]
      · simp [h0 a (by simp)]
      · simp

theorem genSpan_of_z_zero (hph : ∀ i, (g i).phase = 0) (h0 : ∀ i, (g i).z = 0)
    (a : Fin m → ZMod 2) : genSpan g a = ⟨0, ∑ i, a i • (g i).x, 0⟩ := by
  have h2 : ∀ u : ZMod 2, u = 0 ∨ u = 1 := by decide
  have hp : ∀ i, ((g i) ^ (a i).val).phase = 0 := fun i => by
    rcases h2 (a i) with h | h <;> rw [h] <;>
      simp [show ((0 : ZMod 2)).val = 0 from rfl, show ((1 : ZMod 2)).val = 1 from rfl, hph i]
  have hzz : ∀ i, ((g i) ^ (a i).val).z = 0 := fun i => by simp [h0 i]
  rw [genSpan, list_prod_of_z_zero _ _ (fun i _ => hp i) (fun i _ => hzz i)]
  refine PauliOp.ext rfl ?_ rfl
  show ((List.finRange m).map fun i => ((g i) ^ (a i).val).x).sum = ∑ i, a i • (g i).x
  rw [Fin.sum_univ_def]
  exact congrArg List.sum (List.map_congr_left fun i _ => by rw [pow_x, val_nsmul])

theorem genSpan_of_x_zero (hph : ∀ i, (g i).phase = 0) (h0 : ∀ i, (g i).x = 0)
    (a : Fin m → ZMod 2) : genSpan g a = ⟨0, 0, ∑ i, a i • (g i).z⟩ := by
  have h2 : ∀ u : ZMod 2, u = 0 ∨ u = 1 := by decide
  have hp : ∀ i, ((g i) ^ (a i).val).phase = 0 := fun i => by
    rcases h2 (a i) with h | h <;> rw [h] <;>
      simp [show ((0 : ZMod 2)).val = 0 from rfl, show ((1 : ZMod 2)).val = 1 from rfl, hph i]
  have hxx : ∀ i, ((g i) ^ (a i).val).x = 0 := fun i => by simp [h0 i]
  rw [genSpan, list_prod_of_x_zero _ _ (fun i _ => hp i) (fun i _ => hxx i)]
  refine PauliOp.ext rfl rfl ?_
  show ((List.finRange m).map fun i => ((g i) ^ (a i).val).z).sum = ∑ i, a i • (g i).z
  rw [Fin.sum_univ_def]
  exact congrArg List.sum (List.map_congr_left fun i _ => by rw [pow_z, val_nsmul])

/-- Two Paulis commute exactly when their `betaPair` is symmetric. -/
theorem mul_comm_iff_betaPair (P Q : PauliOp n) :
    P * Q = Q * P ↔ betaPair P Q = betaPair Q P := by
  have tau_inj : ∀ s t : ZMod 2, tau s = tau t → s = t := by decide
  constructor
  · intro h
    have h1 := congrArg PauliOp.phase h
    simp only [mul_phase] at h1
    exact tau_inj _ _ (by simpa [add_comm P.phase Q.phase] using h1)
  · intro h
    exact PauliOp.ext (by simp [mul_phase, h]; ring) (by simp [mul_x]; ring)
      (by simp [mul_z]; ring)

/-- A `GF(2)` bilinear-orthogonality transfer: if every pair of rows is orthogonal, so is every
pair of linear combinations. -/
theorem sum_smul_dot {p q : ℕ} (u : Fin p → (Fin n → ZMod 2)) (v : Fin q → (Fin n → ZMod 2))
    (a : Fin p → ZMod 2) (c : Fin q → ZMod 2) (h : ∀ i j, ∑ k, u i k * v j k = 0) :
    ∑ k, (∑ i, a i • u i) k * (∑ j, c j • v j) k = 0 := by
  have key : ∀ k : Fin n, (∑ i, a i • u i) k * (∑ j, c j • v j) k
      = ∑ i, ∑ j, a i * c j * (u i k * v j k) := by
    intro k
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    rw [Finset.sum_mul_sum]
    exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
  simp only [key]
  rw [Finset.sum_comm]
  refine Finset.sum_eq_zero fun i _ => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_eq_zero fun j _ => ?_
  rw [← Finset.mul_sum, h i j, mul_zero]

namespace IsGenFamily

variable (hg : IsGenFamily g)
include hg

theorem span_add (a b : Fin m → ZMod 2) : genSpan g (a + b) = genSpan g a * genSpan g b := by
  rw [genSpan, genSpan, genSpan,
    list_prod_mul_prod _ _ _ fun i _ j _ => (hg.comm i j).pow_pow _ _]
  exact congrArg List.prod (List.map_congr_left fun i _ => pow_val_add (hg.sq i) (a i) (b i))

theorem span_mul_self (a : Fin m → ZMod 2) : genSpan g a * genSpan g a = 1 := by
  rw [← hg.span_add, show a + a = 0 by ext i; simp [CharTwo.add_self_eq_zero], genSpan_zero]

theorem span_inv (a : Fin m → ZMod 2) : (genSpan g a)⁻¹ = genSpan g a :=
  inv_eq_of_mul_eq_one_right (hg.span_mul_self a)

theorem span_comm (a b : Fin m → ZMod 2) :
    genSpan g a * genSpan g b = genSpan g b * genSpan g a := by
  rw [← hg.span_add, ← hg.span_add, add_comm]

omit hg in
theorem span_single (i : Fin m) : genSpan g (Pi.single i 1) = g i := by
  rw [genSpan, list_prod_single (List.mem_finRange i) (List.nodup_finRange m)]
  · simp [show ((1 : ZMod 2)).val = 1 from rfl]
  · intro j _ hj
    simp [Pi.single_eq_of_ne hj, show ((0 : ZMod 2)).val = 0 from rfl]

/-- **Normal form.** The subgroup generated by a commuting family of Pauli involutions is exactly
the set of products of subfamilies. -/
theorem mem_closure_iff {P : PauliOp n} :
    P ∈ Subgroup.closure (Set.range g) ↔ ∃ a, genSpan g a = P := by
  constructor
  · intro hP
    refine Subgroup.closure_induction (p := fun x _ => ∃ a, genSpan g a = x) ?_ ?_ ?_ ?_ hP
    · rintro _ ⟨i, rfl⟩
      exact ⟨Pi.single i 1, span_single i⟩
    · exact ⟨0, genSpan_zero⟩
    · rintro _ _ _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
      exact ⟨a + b, hg.span_add a b⟩
    · rintro _ _ ⟨a, rfl⟩
      exact ⟨a, (hg.span_inv a).symm⟩
  · rintro ⟨a, rfl⟩
    exact genSpan_mem_closure a

/-- The generated subgroup is abelian: the first stabilizer axiom. -/
theorem isComm : ∀ a ∈ Subgroup.closure (Set.range g), ∀ b ∈ Subgroup.closure (Set.range g),
    a * b = b * a := by
  intro a ha b hb
  obtain ⟨u, rfl⟩ := hg.mem_closure_iff.mp ha
  obtain ⟨v, rfl⟩ := hg.mem_closure_iff.mp hb
  exact hg.span_comm u v

end IsGenFamily

/-! ### Centralizing a generated subgroup -/

/-- To commute with everything in a generated subgroup it suffices to commute with the
generators. -/
theorem mem_centralizer_closure_iff {s : Set (PauliOp n)} {P : PauliOp n} :
    P ∈ Subgroup.centralizer (Subgroup.closure s : Set (PauliOp n)) ↔ ∀ q ∈ s, q * P = P * q := by
  constructor
  · intro h q hq
    exact h q (Subgroup.subset_closure hq)
  · intro h q hq
    induction hq using Subgroup.closure_induction with
    | mem x hx => exact h x hx
    | one => simp
    | mul x y _ _ hx hy => rw [mul_assoc, hy, ← mul_assoc, hx, mul_assoc]
    | inv x _ hx =>
        have hc : _root_.Commute x P := hx
        exact hc.inv_left

/-! ### Multiplying by phases -/

namespace StabGroup

/-- Elements of `phaseSubgroup` are central. -/
theorem phase_mul_comm (k : ZMod 4) (P : PauliOp n) :
    (⟨k, 0, 0⟩ : PauliOp n) * P = P * ⟨k, 0, 0⟩ := by
  refine PauliOp.ext ?_ (by simp [add_comm]) (by simp [add_comm])
  simp only [mul_phase, betaPair, Pi.zero_apply, zero_mul, mul_zero, Finset.sum_const_zero,
    tau_zero, add_zero]
  ring

instance phaseSubgroup_normal : (phaseSubgroup n).Normal where
  conj_mem := by
    intro p hp q
    rw [mem_phaseSubgroup] at hp ⊢
    obtain ⟨hx, hz⟩ := hp
    have hp' : p = (⟨p.phase, 0, 0⟩ : PauliOp n) := by ext <;> simp [hx, hz]
    rw [hp', ← phase_mul_comm, mul_assoc, mul_inv_cancel, mul_one]
    exact ⟨rfl, rfl⟩

/-- **The operators that act trivially on the code space.** `P` lies in `H ⊔ phaseSubgroup` exactly
when some element of `H` has the same `x`- and `z`-components; the phase is then free. -/
theorem mem_sup_phaseSubgroup_iff {H : Subgroup (PauliOp n)} {P : PauliOp n} :
    P ∈ H ⊔ phaseSubgroup n ↔ ∃ h ∈ H, h.x = P.x ∧ h.z = P.z := by
  constructor
  · intro hP
    rw [← SetLike.mem_coe, Subgroup.mul_normal] at hP
    obtain ⟨h, hh, p, hp, rfl⟩ := hP
    rw [SetLike.mem_coe, mem_phaseSubgroup] at hp
    exact ⟨h, hh, by simp [hp.1], by simp [hp.2]⟩
  · rintro ⟨h, hh, hx, hz⟩
    rw [← SetLike.mem_coe, Subgroup.mul_normal]
    refine ⟨h, hh, ⟨P.phase - h.phase, 0, 0⟩, (mem_phaseSubgroup).mpr ⟨rfl, rfl⟩, ?_⟩
    refine PauliOp.ext ?_ (by simp [hx]) (by simp [hz])
    simp only [mul_phase, betaPair, Pi.zero_apply, mul_zero, Finset.sum_const_zero, tau_zero,
      add_zero]
    ring

/-! ### A decidable criterion for `IsLogical`, and for `distance` -/

variable {S : StabGroup n}

/-- **The working criterion for a logical operator.** For a code presented by a commuting family of
generators, `P` is logical iff it commutes with every generator yet no product of generators has its
`x`- and `z`-components. Every ingredient is a finite check. -/
theorem isLogical_iff_of_gens (hg : IsGenFamily g)
    (hS : S.carrier = Subgroup.closure (Set.range g)) {P : PauliOp n} :
    S.IsLogical P ↔ (∀ i, g i * P = P * g i) ∧
      ¬ ∃ a, (genSpan g a).x = P.x ∧ (genSpan g a).z = P.z := by
  rw [IsLogical, hS]
  refine and_congr ?_ (not_congr ?_)
  · rw [mem_centralizer_closure_iff]
    exact ⟨fun h i => h (g i) ⟨i, rfl⟩, by rintro h _ ⟨i, rfl⟩; exact h i⟩
  · rw [mem_sup_phaseSubgroup_iff]
    constructor
    · rintro ⟨h, hh, hx, hz⟩
      obtain ⟨a, rfl⟩ := hg.mem_closure_iff.mp hh
      exact ⟨a, hx, hz⟩
    · rintro ⟨a, hx, hz⟩
      exact ⟨genSpan g a, hg.mem_closure_iff.mpr ⟨a, rfl⟩, hx, hz⟩

/-- `distance` is pinned down by a witness of weight `d` together with a lower bound. -/
theorem distance_eq (S : StabGroup n) (d : ℕ)
    (hex : ∃ P, S.IsLogical P ∧ weight P = d)
    (hlb : ∀ P, S.IsLogical P → d ≤ weight P) : S.distance = d := by
  obtain ⟨P, hP, hwP⟩ := hex
  refine le_antisymm (Nat.sInf_le ⟨P, hP, hwP⟩) ?_
  obtain ⟨Q, hQ, hwQ⟩ := Nat.sInf_mem (s := {w | ∃ Q, S.IsLogical Q ∧ weight Q = w}) ⟨_, P, hP, hwP⟩
  calc d ≤ weight Q := hlb Q hQ
    _ = sInf {w | ∃ Q, S.IsLogical Q ∧ weight Q = w} := hwQ

open Classical in
/-- The stabilizer has `2ᵐ` elements when the generators are independent. -/
theorem card_carrier_of_gens (hg : IsGenFamily g)
    (hS : S.carrier = Subgroup.closure (Set.range g)) (hinj : Function.Injective (genSpan g)) :
    Fintype.card S.carrier = 2 ^ m := by
  classical
  have hb : Function.Bijective (fun a : Fin m → ZMod 2 =>
      (⟨genSpan g a, by rw [hS]; exact genSpan_mem_closure a⟩ : S.carrier)) := by
    constructor
    · exact fun a b hab => hinj (congrArg Subtype.val hab)
    · rintro ⟨P, hP⟩
      obtain ⟨a, rfl⟩ := hg.mem_closure_iff.mp (hS ▸ hP)
      exact ⟨a, rfl⟩
  rw [← Fintype.card_of_bijective hb, Fintype.card_fun, ZMod.card, Fintype.card_fin]

open Classical in
/-- With independent generators, `k = n − m`. -/
theorem numLogical_of_gens (hg : IsGenFamily g)
    (hS : S.carrier = Subgroup.closure (Set.range g)) (hinj : Function.Injective (genSpan g)) :
    S.numLogical = n - m := by
  rw [numLogical, card_carrier_of_gens hg hS hinj, Nat.log_pow (by decide : 1 < 2)]

end StabGroup
end PauliOp
end QuantumLib
